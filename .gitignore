# Python virtualenv and caches
env/
__pycache__/
*.pyc

# Node dependencies
node_modules/

# Generated by bench (recreated by bench setup / bench start)
config/
logs/
Procfile
sites/assets/
sites/apps.txt

# Each app under apps/ is its own git repository (cloned by bench get-app).
# Do not track them inside the bench repo.
apps/

# Per-site data: site_config.json holds database passwords, and private/ and
# public/ hold uploaded files. Never commit these.
sites/*/

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store
